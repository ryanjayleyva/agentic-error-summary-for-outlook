{
  "_id": "60667a2c011356bfd76032e1",
  "name": "Errors Toolkit - Get Errors From File",
  "description": "Reads errorsByBubble.json from Celigo file storage and deletes the file after reading it. A preSavePage script wraps the records in a flowBubbles list for the AI agent.",
  "_connectionId": "c0bdf086b76e7e8b4c4d8fdb",
  "apiIdentifier": "e96f188a6d",
  "asynchronous": true,
  "hooks": {
