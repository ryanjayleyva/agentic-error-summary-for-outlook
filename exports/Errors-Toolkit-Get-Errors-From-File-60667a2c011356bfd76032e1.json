      "function": "preSavePage",
      "_scriptId": "6e1222b249038d29269916ee"
    }
  },
  "assistant": "integratorceligoapi",
  "http": {
    "type": "file",
    "relativeURI": "Agentic Error Summary for Outlook",
    "method": "GET",
    "isRest": false,
    "sendAuthForFileDownloads": false,
    "formType": "assistant",
    "response": {
