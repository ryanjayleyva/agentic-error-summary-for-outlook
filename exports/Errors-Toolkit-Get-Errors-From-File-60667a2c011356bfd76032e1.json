          "errorsByBubble"
        ]
      },
      "rules": [
        "startswith",
        [
          "string",
          [
            "extract",
            "filename"
          ]
        ],
        "errorsByBubble"
      ],
      "version": "1"
    }
  },
  "adaptorType": "HTTPExport"
}